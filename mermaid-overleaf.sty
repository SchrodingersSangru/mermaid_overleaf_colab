%% ============================================================
%%  mermaid-overleaf.sty
%%  Render Mermaid diagrams in Overleaf (cloud) without
%%  shell-escape by providing:
%%    1. A beautiful code-listing display of the Mermaid source
%%    2. \includegraphics-based figure inclusion with captions,
%%       labels, and positioning — for pre-rendered images
%%    3. Diagram-type-aware styling (flowchart, sequence,
%%       gantt, class, state, ER, timeline, pie, mindmap, git)
%%    4. A full colour theme system with 5 built-in themes
%%    5. A \MermaidLive helper that prints a clickable QR /
%%       URL to preview the diagram online
%%
%%  USAGE — two modes:
%%
%%  Mode A: Source-display (no pre-rendered image)
%%    \begin{mermaid}[type=flowchart, theme=ocean, caption={My flow}]
%%      graph TD
%%        A[Start] --> B{Decision}
%%        B -->|Yes| C[Done]
%%        B -->|No| A
%%    \end{mermaid}
%%
%%  Mode B: Pre-rendered image (recommended for publication)
%%    \begin{mermaid}[image=figs/flow.pdf, caption={My flow}, label={fig:flow}]
%%      graph TD
%%        A --> B
%%    \end{mermaid}
%%
%%  Author: mermaid-overleaf contributors
%%  License: LPPL 1.3c
%%  Repository: https://github.com/YOUR-USERNAME/mermaid-overleaf
%% ============================================================

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mermaid-overleaf}[2026/09/09 v1.0 Mermaid diagrams for cloud Overleaf]

%% ── Dependencies ────────────────────────────────────────────
\RequirePackage{xkeyval}        % key=value options
\RequirePackage{xcolor}         % colour support
\RequirePackage{listings}       % code listing engine
\RequirePackage{graphicx}       % \includegraphics
\RequirePackage{caption}        % caption styling
\RequirePackage{float}          % [H] placement
\RequirePackage{adjustbox}      % max width scaling
\RequirePackage{tcolorbox}      % coloured box frames
\RequirePackage{environ}        % \NewEnviron
\RequirePackage{etoolbox}       % \ifblank etc.
\RequirePackage{ifthen}         % \ifthenelse
\RequirePackage{tikz}           % diagram type badge
\RequirePackage{mdframed}       % source listing frame
\RequirePackage{geometry}       % used only for demo; no-op here
\tcbuselibrary{skins,breakable,listings}

%% ── Package-level option: default theme ─────────────────────
\newcommand{\mmd@defaulttheme}{ocean}
\DeclareOptionX{theme}{\renewcommand{\mmd@defaulttheme}{#1}}
\ProcessOptionsX\relax

