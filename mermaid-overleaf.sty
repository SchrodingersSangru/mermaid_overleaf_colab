%% ── Theme resolver ──────────────────────────────────────────
\newcommand{\mmd@settheme}[1]{%
  \def\mmd@theme{#1}%
  \colorlet{mmd@bg}     {mmd-#1-bg}%
  \colorlet{mmd@frame}  {mmd-#1-frame}%
  \colorlet{mmd@kw}     {mmd-#1-kw}%
  \colorlet{mmd@str}    {mmd-#1-str}%
  \colorlet{mmd@cmt}    {mmd-#1-cmt}%
  \colorlet{mmd@badge}  {mmd-#1-badge}%
  \colorlet{mmd@accent} {mmd-#1-accent}%
}
\mmd@settheme{\mmd@defaulttheme}   % initialise with package default

%% ============================================================
%%  LISTINGS LANGUAGE DEFINITION for Mermaid
%% ============================================================
\lstdefinelanguage{Mermaid}{%
  keywords={%
    graph,flowchart,TD,LR,RL,BT,TB,
    sequenceDiagram,participant,actor,as,activate,deactivate,
    loop,alt,else,opt,par,and,rect,Note,over,left,of,right,
    classDiagram,class,
    stateDiagram,stateDiagram-v2,state,
    erDiagram,
    gantt,title,dateFormat,section,
    timeline,
    pie,showData,
    mindmap,
    gitGraph,commit,branch,checkout,merge,
    journey,
    subgraph,end,
    click,style,linkStyle,classDef,
    direction
  },
  keywordstyle=\color{mmd@kw}\bfseries,
  sensitive=false,
  morestring=[b]",
  morestring=[b]',
  stringstyle=\color{mmd@str},
  morecomment=[l]{\%\%},
  commentstyle=\color{mmd@cmt}\itshape,
}

%% ── Shared listings style ───────────────────────────────────
\lstdefinestyle{mermaid-listing}{%
  language=Mermaid,
  basicstyle=\ttfamily\small\color{mmd@str},
  backgroundcolor=\color{mmd@bg},
  frame=none,
  aboveskip=0pt,
  belowskip=0pt,
  xleftmargin=1em,
  xrightmargin=1em,
  showstringspaces=false,
  breaklines=true,
  breakatwhitespace=false,
  tabsize=2,
  columns=fullflexible,
  keepspaces=true,
  upquote=true,
}

%% ============================================================
%%  DIAGRAM-TYPE BADGE ICONS (TikZ)
%% ============================================================
\newcommand{\mmd@badge}[1]{%
  \begin{tikzpicture}[baseline=-0.6ex]
    \node[
      fill=mmd@badge,
      text=white,
      font=\sffamily\bfseries\tiny,
      inner sep=2pt,
      rounded corners=2pt,
    ] {#1};
  \end{tikzpicture}%
}

\newcommand{\mmd@typebadge}[1]{%
  \ifthenelse{\equal{#1}{flowchart}}   {\mmd@badge{FLOW}}{%
  \ifthenelse{\equal{#1}{sequence}}    {\mmd@badge{SEQ}}{%
  \ifthenelse{\equal{#1}{gantt}}       {\mmd@badge{GANTT}}{%
  \ifthenelse{\equal{#1}{class}}       {\mmd@badge{CLASS}}{%
  \ifthenelse{\equal{#1}{state}}       {\mmd@badge{STATE}}{%
  \ifthenelse{\equal{#1}{er}}          {\mmd@badge{ER}}{%
  \ifthenelse{\equal{#1}{pie}}         {\mmd@badge{PIE}}{%
  \ifthenelse{\equal{#1}{timeline}}    {\mmd@badge{TIME}}{%
  \ifthenelse{\equal{#1}{mindmap}}     {\mmd@badge{MIND}}{%
  \ifthenelse{\equal{#1}{git}}         {\mmd@badge{GIT}}{%
  \ifthenelse{\equal{#1}{journey}}     {\mmd@badge{UX}}{%
  \mmd@badge{MMD}%
  }}}}}}}}}}}%
}

%% ============================================================
%%  KEY=VALUE OPTION DECLARATIONS FOR THE ENVIRONMENT
%% ============================================================
\define@key{mmd}{type}   {\def\mmd@type{#1}}
\define@key{mmd}{theme}  {\mmd@settheme{#1}}
\define@key{mmd}{image}  {\def\mmd@image{#1}}
\define@key{mmd}{caption}{\def\mmd@caption{#1}}
\define@key{mmd}{label}  {\def\mmd@label{#1}}
\define@key{mmd}{width}  {\def\mmd@width{#1}}
\define@key{mmd}{pos}    {\def\mmd@pos{#1}}
\define@key{mmd}{scale}  {\def\mmd@scale{#1}}

%% ── Defaults ────────────────────────────────────────────────
\newcommand{\mmd@type}   {flowchart}
\newcommand{\mmd@image}  {}
\newcommand{\mmd@caption}{}
\newcommand{\mmd@label}  {}
\newcommand{\mmd@width}  {0.85\linewidth}
\newcommand{\mmd@pos}    {H}
\newcommand{\mmd@scale}  {1}

%% ============================================================
%%  CAPTION SETUP  — clean, minimal
%% ============================================================
\DeclareCaptionFont{mmdcap}{\small\sffamily}
\captionsetup[figure]{font=mmdcap, labelfont={bf,mmdcap}}

%% ============================================================
%%  CORE ENVIRONMENT
%% ============================================================
\NewEnviron{mermaid}[1][]{%
  %% Reset per-diagram defaults
  \def\mmd@type{flowchart}%
  \def\mmd@image{}%
  \def\mmd@caption{}%
  \def\mmd@label{}%
  \def\mmd@width{0.85\linewidth}%
  \def\mmd@pos{H}%
  \def\mmd@scale{1}%
  \mmd@settheme{\mmd@defaulttheme}%
  %% Parse options
  \setkeys{mmd}{#1}%
  %%
  \ifblank{\mmd@image}{%
    %% ── MODE A: source listing display ──────────────────────
    \mmd@renderlisting%
  }{%
    %% ── MODE B: pre-rendered image ──────────────────────────
    \mmd@renderimage%
  }%
}

%% ── Mode A: listing renderer ─────────────────────────────────
\newcommand{\mmd@renderlisting}{%
  \begin{figure}[\mmd@pos]
    \centering
    %% Outer tcolorbox frame
    \begin{tcolorbox}[
      enhanced,
      colback=mmd@bg,
      colframe=mmd@frame,
      boxrule=1.2pt,
      arc=5pt,
      left=6pt, right=6pt, top=4pt, bottom=4pt,
      width=\mmd@width,
      before upper={\mmd@headerbar},
    ]
      \lstset{style=mermaid-listing}%
      \lstinline[style=mermaid-listing]{}% force colour reset
      \begin{lstlisting}[style=mermaid-listing]
\BODY
      \end{lstlisting}
    \end{tcolorbox}
    %% Caption
    \ifblank{\mmd@caption}{}{%
      \captionsetup{justification=centering}%
      \caption{\mmd@caption}%
      \ifblank{\mmd@label}{}{\label{\mmd@label}}%
    }%
  \end{figure}
}

%% ── Header bar with badge + "Mermaid" wordmark ───────────────
\newcommand{\mmd@headerbar}{%
  \begin{tikzpicture}[overlay, remember picture]
  \end{tikzpicture}%
  {\color{mmd@accent}\rule{\linewidth}{0.4pt}}\\[2pt]
  \makebox[\linewidth][l]{%
    \hspace{0.5em}%
    \mmd@typebadge{\mmd@type}%
    \hspace{0.4em}%
    {\color{mmd@cmt}\sffamily\tiny mermaid diagram}%
    \hfill
    {\color{mmd@frame}\sffamily\tiny\itshape mermaid-overleaf}%
    \hspace{0.3em}%
  }\\[2pt]
  {\color{mmd@accent}\rule{\linewidth}{0.4pt}}\\[4pt]
}

%% ── Mode B: image renderer ───────────────────────────────────
\newcommand{\mmd@renderimage}{%
  \begin{figure}[\mmd@pos]
    \centering
    %% Thin rule frame around the image
    \setlength{\fboxsep}{4pt}%
    \setlength{\fboxrule}{1.0pt}%
    \fcolorbox{mmd@frame}{white}{%
      \adjustbox{max width=\mmd@width}{%
        \includegraphics[scale=\mmd@scale]{\mmd@image}%
      }%
    }%
    %% Source listing below the image (collapsible feel)
    \vspace{2pt}%
    \begin{tcolorbox}[
      enhanced,
      colback=mmd@bg,
      colframe=mmd@frame,
      boxrule=0.6pt,
      arc=3pt,
      left=4pt, right=4pt, top=2pt, bottom=2pt,
      width=\mmd@width,
      fontupper=\ttfamily\scriptsize\color{mmd@cmt},
    ]
      \mmd@typebadge{\mmd@type}\enspace
      {\color{mmd@cmt}\textit{Source:}}\\[2pt]
      \begin{lstlisting}[style=mermaid-listing, basicstyle=\ttfamily\scriptsize\color{mmd@str}]
\BODY
      \end{lstlisting}
    \end{tcolorbox}
    \ifblank{\mmd@caption}{}{%
      \captionsetup{justification=centering}%
      \caption{\mmd@caption}%
      \ifblank{\mmd@label}{}{\label{\mmd@label}}%
    }%
  \end{figure}
}

%% ============================================================
%%  INLINE COMMAND — for a single short node label styled
%%  like Mermaid code in running text
%%  Usage: \mermaidcode{graph TD; A --> B}
%% ============================================================
\newcommand{\mermaidcode}[1]{%
  \lstinline[style=mermaid-listing,basicstyle=\ttfamily\small\color{mmd@kw}]{#1}%
}

%% ============================================================
%%  \MermaidSetTheme{<theme>} — change default theme mid-doc
%% ============================================================
\newcommand{\MermaidSetTheme}[1]{\mmd@settheme{#1}}

%% ============================================================
%%  \MermaidLive{<mermaid source>}
%%  Prints a note box with a link to mermaid.live
%%  (URL-encodes only minimal characters for readability)
%% ============================================================
\newcommand{\MermaidLiveNote}{%
  \begin{tcolorbox}[
    enhanced,
    colback=mmd@bg!60!white,
    colframe=mmd@accent,
    boxrule=0.8pt,
    arc=3pt,
    left=6pt, right=6pt, top=3pt, bottom=3pt,
    fontupper=\sffamily\small,
  ]
    {\color{mmd@accent}\bfseries Preview online:}\enspace
    {\color{mmd@kw}\ttfamily https://mermaid.live}\\[2pt]
    {\color{mmd@cmt}\footnotesize
      Paste the Mermaid source above into the Mermaid Live Editor
      to preview and export your diagram as SVG or PNG,
      then upload the result to your Overleaf project.}
  \end{tcolorbox}%
}

%% ============================================================
%%  \MermaidWorkflow — prints a boxed "how to use" mini-guide
%% ============================================================
\newcommand{\MermaidWorkflow}{%
  \begin{tcolorbox}[
    enhanced,
    colback=mmd@bg,
    colframe=mmd@frame,
    boxrule=1pt,
    arc=4pt,
    title={\sffamily\bfseries\color{white} Mermaid $\to$ Overleaf Workflow},
    attach boxed title to top left={yshift=-2mm, xshift=4mm},
    boxed title style={colback=mmd@badge, arc=2pt},
    left=8pt, right=8pt, top=8pt, bottom=6pt,
  ]
    {\color{mmd@kw}\bfseries\sffamily Step 1\enspace}
    {\color{mmd@str}\sffamily Write your diagram in the \texttt{mermaid} environment below.}\\[4pt]
    {\color{mmd@kw}\bfseries\sffamily Step 2\enspace}
    {\color{mmd@str}\sffamily Visit \texttt{https://mermaid.live} and paste the source.}\\[4pt]
    {\color{mmd@kw}\bfseries\sffamily Step 3\enspace}
    {\color{mmd@str}\sffamily Export as PDF or SVG and upload to your Overleaf project.}\\[4pt]
    {\color{mmd@kw}\bfseries\sffamily Step 4\enspace}
    {\color{mmd@str}\sffamily Use \texttt{image=\{your-file\}} option to include the rendered diagram.}
  \end{tcolorbox}
}

\endinput
